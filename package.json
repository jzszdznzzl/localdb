{
  "name": "@jzszdznzzl/localdb",
  "version": "2.0.0",
  "description": "Typed JSON document store for Node.js and Bun: validated with zod, saved in one append-only file, no server.",
  "keywords": [
    "database",
    "embedded-database",
    "document-database",
    "document-store",
    "json",
    "jsonl",
    "json-lines",
    "zod",
    "typescript",
    "nodejs",
    "bun",
    "nosql",
    "persistence",
    "append-only",
    "local",
    "lowdb-alternative",
    "localdb"
  ],
  "homepage": "https://github.com/jzszdznzzl/localdb#readme",
  "bugs": "https://github.com/jzszdznzzl/localdb/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jzszdznzzl/localdb.git"
  },
  "license": "MIT",
  "author": {
    "name": "José Daniel Cristaldo Vera",
    "url": "https://jzszdznzzl.dev",
    "email": "me@jzszdznzzl.dev"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=12"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "lint": "oxlint --type-aware",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "build": "tsdown",
    "test": "node --test 'src/**/*.test.ts'",
    "test:bun": "bun test src",
    "bench": "node --expose-gc --max-old-space-size=8192 scripts/bench.ts",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "prepare": "pnpm build",
    "prepublishOnly": "pnpm check"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "0.18.5",
    "@types/node": "24.19.2",
    "lowdb": "7.0.1",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "prettier": "3.9.10",
    "publint": "0.3.25",
    "tsdown": "0.23.1",
    "typescript": "7.0.2",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  }
}
